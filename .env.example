# Copy to .env for local overrides. Never commit real values.
DATABASE_URL=postgresql+asyncpg://labor:labor@localhost:5435/labor

# The embedding model: bge-m3 (needs `uv sync --extra embeddings`) or hash (a fake, for development)
EMBEDDER=bge-m3

# Who writes the answers: fake (tests), claude, or chat (Ollama or a free hosted service).
ANSWERER=fake
# ANTHROPIC_API_KEY=            # for ANSWERER=claude; the key lives only here, never in code
# ANSWER_MODEL=claude-sonnet-5-5
# ANSWER_EFFORT=low
# CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# CHAT_MODEL=                   # for ANSWERER=chat
# CHAT_API_KEY=
